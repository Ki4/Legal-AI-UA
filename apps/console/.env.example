# Copy to .env in this directory. The anon key is browser-safe (RLS guards all data).
# The service_role key must NEVER appear anywhere in the frontend or in git.
#
# Local sandbox (preferred for development): run `pnpm exec supabase start` from the repo
# root, then `pnpm exec supabase status` and paste the printed API URL and anon key here.
# The local URL is http://127.0.0.1:54321. See supabase/README.md.
#
# Cloud project: take the values from the Supabase dashboard, Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
