        "service_version_id": "sv-divorce-3",
        "order_id": 412
      }
    },
    {
      "schema": "generation-request",
      "name": "an empty service version id, which pins no version at all",
      "constraint": "minLength",
      "value": {
        "service_version_id": "",
        "order_id": "ord-2026-000412"
      }
    }
  ]
}
